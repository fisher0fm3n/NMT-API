# KingsPresenter (routes/kingspresenter.js); every setting is in KINGSPRESENTER_API.md.
# Copy to .env and fill in. Never commit .env.

# The KingsPresenter database (Postgres).
KINGSPRESENTER_DATABASE_URL=postgres://user:password@host:5432/kingspresenter

# KingsChat: KingsPresenter's own client ("Desktop App", Web, Form POST), whose redirect is
# this service's callback, https://nmt.loveworldapis.com/api/kp/auth/kingschat/callback.
KP_KC_CLIENT_ID=
KP_SITE_URL=https://nmt.loveworldapis.com/api/kp
# Earlier client ids still accepted from app builds that use them (comma separated).
KP_KC_LEGACY_CLIENT_IDS=
# Optional: KingsChat's api-key header, and the client secret if KingsChat issued one.
KP_KC_API_KEY=
KP_KC_CLIENT_SECRET=

# This service's public address up to /api (the links to installers).
KP_PUBLIC_URL=https://nmt.loveworldapis.com/api
# The administrator's key (the KingsPresenter site's /admin): openssl rand -hex 32
KP_ADMIN_KEY=
# Deepgram's key for Cloud listening (Member rights or more): kept here, never in the app.
# The apps get a 30-second token from it (POST /kp/listening/token).
KP_DEEPGRAM_API_KEY=
# The build uploads installers with this: the same value as the GitHub secret UPDATE_UPLOAD_KEY.
KP_UPDATE_UPLOAD_KEY=
# Relays report Remote sessions with this.
KP_RELAY_KEY=

# Optional
# KP_API_KEY=            the apps' key (x-api-key); unset: no app key needed
# KP_MAX_DEVICES=0       devices one account may be signed in on at once (0: no limit)
# KP_CLOUD_MINUTES=120   cloud listening each account may use a month (an account's own: the admin page)
# KP_SUMMARY_MODEL=gpt-4.1-mini
# KP_RELEASES_DIR=~/kingspresenter-releases
# KP_MEDIA_DIR=~/kingspresenter-media
